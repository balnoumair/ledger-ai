# BFF environment.
# The BFF is a thin proxy — it does NOT hold Plaid credentials.
BACKEND_URL=http://localhost:8080
BFF_PORT=8787

# Allowed origins for CORS (comma-separated). Vite dev server defaults to 5173.
CORS_ORIGINS=http://localhost:5173

# Log level: trace, debug, info, warn, error
LOG_LEVEL=info
