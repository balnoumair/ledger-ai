# Plaid Sandbox credentials. Get these from https://dashboard.plaid.com/.
# Only the backend reads these. Do NOT add them to the BFF or desktop app.
PLAID_CLIENT_ID=replace-me
PLAID_SECRET=replace-me

# Plaid environment: sandbox | development | production
# Keep this on `sandbox` for local development. The other environments
# bill against your real Plaid budget.
PLAID_ENV=sandbox

# Postgres connection (defaults match infra/docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledger

# Server
SERVER_PORT=8080
